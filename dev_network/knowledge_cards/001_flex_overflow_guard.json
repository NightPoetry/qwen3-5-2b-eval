{
  "id": "001",
  "name": "flex子元素防溢出",
  "source": "UI设计/边界可控",
  "phase": "css_validation",
  "trigger": {
    "type": "regex",
    "pattern": "flex:\\s*1(?!.*min-width)",
    "description": "CSS中存在flex:1且同选择器无min-width约束"
  },
  "steps": [
    {
      "actor": "system",
      "action": "regex_find",
      "input": "CSS文件内容",
      "output": "所有包含flex:1的选择器块",
      "code": "re.findall(r'([^{}]+)\\{[^}]*flex:\\s*1[^}]*\\}', css)"
    },
    {
      "actor": "system",
      "action": "check_property",
      "input": "选择器块",
      "output": "是否已有min-width",
      "code": "'min-width' in block"
    },
    {
      "actor": "system",
      "action": "inject",
      "input": "缺少min-width的选择器块",
      "output": "添加 min-width:0; overflow:hidden;",
      "condition": "step2 == False"
    }
  ],
  "refs": ["010"],
  "model_involvement": "none",
  "deterministic": true
}
