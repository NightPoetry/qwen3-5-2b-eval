{
  "id": "007",
  "name": "对齐用grid不用flex",
  "source": "UI设计/横平竖直",
  "phase": "css_validation",
  "trigger": {
    "type": "regex",
    "pattern": "display:\\s*flex",
    "description": "检测使用flex的等分/对齐场景，建议改grid"
  },
  "steps": [
    {
      "actor": "system",
      "action": "detect_pattern",
      "input": "CSS中的flex声明",
      "output": "识别flex用途类型",
      "detection_rules": [
        "子元素都有flex:1 → 等分场景 → 应用grid",
        "图标+文字菜单 → 固定列 → 应用grid-template-columns",
        "单行居中/排列 → flex正确用法 → 不修改"
      ]
    },
    {
      "actor": "system",
      "action": "suggest_replacement",
      "input": "等分场景的flex",
      "output": "替换为 display:grid; grid-template-columns:repeat(N,1fr)",
      "condition": "场景==等分 且 子元素数已知"
    }
  ],
  "priority": "low",
  "model_involvement": "none",
  "deterministic": true,
  "note": "flex用于弹性流式布局仍然正确，此规则仅针对等分/严格对齐场景"
}
