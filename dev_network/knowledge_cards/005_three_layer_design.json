{
  "id": "005",
  "name": "三层设计分离",
  "source": "编程规范/前端设计经验保存",
  "phase": "architecture",
  "trigger": {
    "type": "always",
    "description": "代码生成架构的核心约束——每层只看自己的信息"
  },
  "layers": {
    "logic": {
      "corresponds_to": "Phase2(契约) + JS数据层",
      "contains": "数据结构、状态管理、业务规则",
      "isolation": "不看HTML/CSS"
    },
    "interaction": {
      "corresponds_to": "Phase0(交互) + JS事件层",
      "contains": "用户操作流程、事件响应、状态转换",
      "isolation": "不看视觉实现"
    },
    "visual": {
      "corresponds_to": "HTML结构 + CSS样式",
      "contains": "配色、字体、布局间距",
      "isolation": "不看业务逻辑"
    }
  },
  "steps": [
    {
      "actor": "system",
      "action": "enforce_isolation",
      "input": "当前phase和对应层",
      "output": "只传递该层需要的契约子集",
      "rule": "每个模型调用的prompt中只包含它所在层的信息，不包含其他层的实现"
    }
  ],
  "principle": "逻辑决定交互，交互决定视觉。上层变动影响下层，下层变动不应影响上层。",
  "refs": ["003", "008"],
  "model_involvement": "none",
  "deterministic": true
}
